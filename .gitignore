# Built binaries (produced by `go build ./...` against the cmd/ trees)
/tai
/triage
/tai-ledger

# Go test artefacts
*.test
*.out

# GoReleaser snapshot/release artefacts (written by `make release-*`).
/dist/

# macOS Finder metadata (matches at every depth — git's default for
# patterns without a slash).
.DS_Store

# Local environment overrides (release tokens, etc.). Never commit.
.env
.env.local
